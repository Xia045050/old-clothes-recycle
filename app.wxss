/* ========== 全局样式 ========== */
page {
  background: #f5f6f8;
  color: #1d2129;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  margin: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(29, 33, 41, 0.04);
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d2129;
  margin-bottom: 24rpx;
}

/* 按钮 */
.btn-primary {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 46rpx;
  background: linear-gradient(90deg, #00c983, #00b578);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(0, 181, 120, 0.28);
}
.btn-primary.disabled {
  opacity: 0.45;
}
.btn-mini {
  height: 56rpx;
  line-height: 52rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  border: 2rpx solid #e5e6eb;
  color: #4e5969;
  font-size: 24rpx;
  background: #fff;
}
.btn-mini.primary {
  border-color: #00b578;
  color: #00b578;
}
.btn-mini.danger {
  border-color: #f53f3f;
  color: #f53f3f;
}

/* 选择胶囊 */
.chip {
  display: inline-block;
  padding: 0 30rpx;
  height: 64rpx;
  line-height: 60rpx;
  border-radius: 34rpx;
  background: #f2f3f5;
  color: #4e5969;
  font-size: 26rpx;
  border: 2rpx solid transparent;
  margin: 0 20rpx 20rpx 0;
  box-sizing: border-box;
}
.chip.active {
  background: #e8fff4;
  color: #00b578;
  border-color: #00b578;
  font-weight: 500;
}

/* 通用布局 */
.row {
  display: flex;
  align-items: center;
}
.row-space {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.col {
  display: flex;
  flex-direction: column;
}
.flex-1 {
  flex: 1;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 600;
}
.sub {
  color: #86909c;
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  font-size: 20rpx;
  color: #00b578;
  background: #e8fff4;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

/* 订单状态色 */
.st-pending {
  color: #ff7d00;
}
.st-done {
  color: #00b578;
}
.st-cancel {
  color: #86909c;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #86909c;
  font-size: 26rpx;
  padding: 140rpx 0;
}
.empty-emoji {
  font-size: 96rpx;
  display: block;
  margin-bottom: 24rpx;
}

/* 分割线 */
.divider {
  height: 2rpx;
  background: #f2f3f5;
  margin: 24rpx 0;
}
