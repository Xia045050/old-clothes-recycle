<view class="page">
  <!-- 状态筛选 -->
  <view class="tabs">
    <view class="tab {{active === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="*this"
      data-index="{{index}}" bindtap="switchTab">{{item}}</view>
  </view>

  <!-- 订单列表 -->
  <block wx:if="{{orders.length > 0}}">
    <view class="card o-card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="row-space">
        <text class="o-id">单号 {{item.id}}</text>
        <text class="o-status {{item.status === '待上门' ? 'st-pending' : (item.status === '已完成' ? 'st-done' : 'st-cancel')}}">{{item.status}}</text>
      </view>
      <view class="o-cats">
        <text class="o-cat" wx:for="{{item.cats}}" wx:for-item="c" wx:key="*this">{{c}}</text>
      </view>
      <view class="o-line">🕒 {{item.dateLabel || item.date}} {{item.slot}}</view>
      <view class="o-line">📍 {{item.address.full}}</view>
      <view class="divider"></view>
      <view class="row-space">
        <text class="sub">预估 {{item.weightKg}}kg · {{item.points}} 积分</text>
        <text class="o-arrow">查看详情 ›</text>
      </view>
    </view>
  </block>

  <!-- 空状态 -->
  <view class="empty" wx:else>
    <text class="empty-emoji">🧺</text>
    <view>暂无相关预约</view>
    <view class="btn-primary empty-btn" bindtap="goBooking">去预约回收</view>
  </view>
</view>
