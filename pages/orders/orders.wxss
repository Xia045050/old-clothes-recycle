.tabs {
  display: flex;
  background: #fff;
  padding: 0 12rpx;
  position: sticky;
  top: 0;
  z-index: 5;
}
.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #4e5969;
  padding: 24rpx 0;
  position: relative;
}
.tab.active {
  color: #00b578;
  font-weight: 600;
}
.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 10rpx;
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #00b578;
}

.o-card {
  margin-top: 24rpx;
}
.o-id {
  font-size: 24rpx;
  color: #86909c;
}
.o-status {
  font-size: 26rpx;
  font-weight: 600;
}
.o-cats {
  margin: 18rpx 0;
}
.o-cat {
  display: inline-block;
  font-size: 24rpx;
  background: #f2f3f5;
  color: #4e5969;
  border-radius: 10rpx;
  padding: 8rpx 18rpx;
  margin-right: 14rpx;
}
.o-line {
  font-size: 24rpx;
  color: #4e5969;
  line-height: 1.9;
}
.o-arrow {
  font-size: 24rpx;
  color: #00b578;
}

.empty-btn {
  margin: 48rpx auto 0;
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}
