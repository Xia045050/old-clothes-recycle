.u-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 44rpx 40rpx;
}
.u-left {
  display: flex;
  align-items: center;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  line-height: 110rpx;
  text-align: center;
  border-radius: 50%;
  background: #e8fff4;
  font-size: 56rpx;
}
.u-info {
  margin-left: 24rpx;
}
.u-name {
  font-size: 34rpx;
  font-weight: 700;
}
.u-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #86909c;
}
.login-btn {
  font-size: 24rpx;
  color: #00b578;
  border: 2rpx solid #00b578;
  border-radius: 30rpx;
  padding: 10rpx 28rpx;
}

/* 统计 */
.stats {
  display: flex;
  align-items: center;
  padding: 32rpx 12rpx;
}
.s-item {
  flex: 1;
  text-align: center;
}
.s-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #1d2129;
}
.s-unit {
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 4rpx;
}
.s-lbl {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #86909c;
}
.s-line {
  width: 2rpx;
  height: 48rpx;
  background: #f2f3f5;
}

/* 菜单 */
.menu {
  padding: 8rpx 32rpx;
}
.m-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #f7f8fa;
}
.m-item:last-child {
  border-bottom: none;
}
.m-ico {
  font-size: 36rpx;
  margin-right: 20rpx;
}
.m-txt {
  flex: 1;
  font-size: 28rpx;
}
.m-sub-tel {
  font-size: 24rpx;
  color: #86909c;
  margin-right: 12rpx;
}
.m-arrow {
  font-size: 36rpx;
  color: #c9cdd4;
}

.reset {
  text-align: center;
  color: #c9cdd4;
  font-size: 24rpx;
  padding: 32rpx 0 60rpx;
}
