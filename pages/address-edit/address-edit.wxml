<view class="page">
  <view class="card">
    <view class="f-row">
      <text class="f-label">联系人</text>
      <input class="f-input" placeholder="收件人姓名" placeholder-class="ph"
        value="{{name}}" bindinput="onName" />
    </view>
    <view class="divider"></view>
    <view class="f-row">
      <text class="f-label">手机号</text>
      <input class="f-input" type="number" maxlength="11" placeholder="11位手机号码" placeholder-class="ph"
        value="{{phone}}" bindinput="onPhone" />
    </view>
    <view class="divider"></view>
    <view class="f-row">
      <text class="f-label">所在地区</text>
      <picker mode="region" value="{{region}}" bindchange="onRegion" class="flex-1">
        <view class="f-picker">{{region[0] ? region[0] + ' ' + region[1] + ' ' + region[2] : '选择省 / 市 / 区'}}</view>
      </picker>
    </view>
    <view class="divider"></view>
    <view class="f-row">
      <text class="f-label">详细地址</text>
      <input class="f-input" placeholder="街道、门牌号、楼栋房号" placeholder-class="ph"
        value="{{detail}}" bindinput="onDetail" />
    </view>
    <view class="divider"></view>
    <view class="f-row">
      <text class="f-label">默认地址</text>
      <view class="flex-1"></view>
      <switch checked="{{isDefault}}" color="#00b578" bindchange="onDefault" />
    </view>
  </view>

  <view class="save-area">
    <view class="btn-primary" bindtap="save">保存</view>
  </view>
</view>
