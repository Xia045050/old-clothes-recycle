/* 积分头部 */
.p-hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #00c983, #00b578 60%, #009a66);
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 44rpx 40rpx;
  color: #fff;
}
.p-label {
  font-size: 24rpx;
  opacity: 0.9;
}
.p-num {
  margin-top: 10rpx;
  font-size: 88rpx;
  font-weight: 700;
  line-height: 1.1;
}
.p-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  opacity: 0.85;
}
.p-recycle {
  margin-top: 20rpx;
  display: inline-block;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 28rpx;
  padding: 10rpx 24rpx;
}
.p-recycle .hl {
  font-weight: 700;
}
.hero-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}
.hero-circle.c1 {
  width: 240rpx;
  height: 240rpx;
  right: -80rpx;
  top: -60rpx;
}
.hero-circle.c2 {
  width: 120rpx;
  height: 120rpx;
  right: 70rpx;
  bottom: -30rpx;
}

/* 环保贡献 */
.eco-row {
  display: flex;
  text-align: center;
}
.eco {
  flex: 1;
}
.e-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #00b578;
}
.e-unit {
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 4rpx;
}
.e-lbl {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #86909c;
}

/* 礼品 */
.gift-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.gift {
  width: 48%;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  margin-bottom: 20rpx;
}
.g-ico {
  font-size: 56rpx;
}
.g-name {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.g-points {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #ff7d00;
  font-weight: 600;
}
.g-btn {
  margin: 16rpx auto 0;
  width: 140rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 26rpx;
  background: linear-gradient(90deg, #00c983, #00b578);
  color: #fff;
  font-size: 24rpx;
}

/* 明细 */
.rec {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f7f8fa;
}
.rec:last-child {
  border-bottom: none;
}
.r-title {
  flex: 1;
  font-size: 26rpx;
}
.r-date {
  font-size: 22rpx;
  color: #86909c;
  margin-right: 24rpx;
}
.r-delta {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff7d00;
  width: 90rpx;
  text-align: right;
}

/* 规则 */
.rules {
  margin: 8rpx 40rpx 40rpx;
  padding: 24rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
}
.rule-t {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.rule {
  font-size: 24rpx;
  color: #86909c;
  line-height: 1.8;
}
